# game / mod assets must never be committed
*.xac
*.xsm
*.cat
*.dat
*.gz
*.dds
*.png
*.obj
*.mtl
*.blend
*.blend1

# extracted or downloaded content
assets/
extensions/
vanilla/
tex_out/
x4cc_*/
mod2b/
tools_archive/

# python
__pycache__/
*.pyc

# 本项目自己的 work/：脚本运行时的中间产物（渲染判据图、临时脚本、
# 试验用的 blender 场景），不是发布内容 —— 发布产物在 work/dist/ 下。
# 不忽略的话 git status 会一直挂着上百 MB 的未跟踪文件（也让人分不清
# 哪些产物是真正要发的）。work/ 已于本次合并从 ../work 移入仓库内。
work/
